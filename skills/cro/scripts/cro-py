#!/usr/bin/env bash
# Run a CRO script with the skill's own Python env (made by install.sh), else system python3.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${DIR}/../.venv/bin/python"
[ -x "$PY" ] || PY="${DIR}/../.venv/Scripts/python.exe"
if [ ! -x "$PY" ]; then
    PY=python3
    echo "cro-py: skill Python env not found, using system python3. Run: \"${DIR}/cro-py\" doctor.py" >&2
fi
exec "$PY" "${DIR}/$1" "${@:2}"
