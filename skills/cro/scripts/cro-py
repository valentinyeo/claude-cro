#!/usr/bin/env bash
# Run a CRO script with the skill's own Python env. install.sh makes it; a plugin install
# has none yet, so the first run builds it from the repo's requirements.txt.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${DIR}/../.venv"
REQ="${DIR}/../../../requirements.txt"
PY="${VENV}/bin/python"
[ -x "$PY" ] || PY="${VENV}/Scripts/python.exe"
if [ ! -x "$PY" ] && [ -f "$REQ" ]; then
    echo "cro-py: first run, setting up the Python env (one minute)..." >&2
    if command -v uv &>/dev/null; then
        uv venv -q --allow-existing "$VENV" >&2 && uv pip install -q --python "${VENV}/bin/python" -r "$REQ" >&2
    else
        python3 -m venv "$VENV" >&2 && "${VENV}/bin/pip" install -q -r "$REQ" >&2
    fi
    [ -x "${VENV}/bin/python" ] && "${VENV}/bin/python" -m playwright install chromium >/dev/null 2>&1
    PY="${VENV}/bin/python"
fi
if [ ! -x "$PY" ]; then
    PY=python3
    echo "cro-py: skill Python env not found, using system python3. Run: \"${DIR}/cro-py\" doctor.py" >&2
fi
exec "$PY" "${DIR}/$1" "${@:2}"
